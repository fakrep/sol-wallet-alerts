# Copy this file to .env and fill in your real values.
# Never commit .env.

# Required: Helius API key for Solana enhanced transactions/RPC.
HELIUS_API_KEY=your_helius_api_key_here

# Required: Telegram bot token from @BotFather.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Required: Telegram user, channel, or group chat id that should receive alerts.
# Group ids are often negative and may start with -100.
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Required in single-wallet mode: Solana wallet address to monitor.
WALLET_ADDRESS=your_solana_wallet_address_here

# Optional: Friendly name shown in Telegram alerts.
WALLET_LABEL=Trading Wallet

# Optional multi-wallet mode. If WALLETS_JSON is set, it replaces
# WALLET_ADDRESS/WALLET_LABEL for monitoring. Wallets without an explicit
# telegram_bot_token_env use TELEGRAM_BOT_TOKEN/TELEGRAM_CHAT_ID above.
# Keep bot tokens in separate env vars, not directly inside WALLETS_JSON.
PRIVATE_TELEGRAM_BOT_TOKEN=another_bot_token_here
WALLETS_JSON=[{"address":"wallet1","label":"Trading Wallet"},{"address":"wallet2","label":"Private Wallet","telegram_bot_token_env":"PRIVATE_TELEGRAM_BOT_TOKEN","telegram_chat_id":"123456789"}]

# Optional: Helius network. Supported values: mainnet, devnet.
HELIUS_NETWORK=mainnet

# Optional: Python logging level: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
